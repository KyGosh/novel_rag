# 复制为 .env 后填写。嵌套配置用双下划线分隔，例如 LLM__API_KEY 对应 settings.llm.api_key。
# 同一个 .env 同时被 docker compose（版本号、密码）和 Python（config.py）读取。

# ---- docker compose：镜像版本（与 CLAUDE.md 锁定版本一致，改动要记入 progress.md）----
ES_VERSION=8.19.23
MILVUS_VERSION=v2.6.25
NEO4J_VERSION=5.26.32-community

# ---- Elasticsearch ----
ES__URL=http://localhost:9200

# ---- Milvus ----
MILVUS__URI=http://localhost:19530

# ---- Neo4j（compose 也用这里的密码初始化，长度至少 8 位）----
NEO4J__URI=bolt://localhost:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=change-me-please

# ---- Kimi（Moonshot 开放平台，OpenAI 兼容接口）----
LLM__BASE_URL=https://api.moonshot.cn/v1
LLM__API_KEY=
LLM__MAX_CONCURRENCY=4
# 按任务覆盖模型名，例如：
# LLM__TASKS__GENERATION__MODEL=kimi-k2.6
# LLM__TASKS__EXTRACTION__MODEL=kimi-k2.6

# ---- 本地模型 ----
# 加载顺序：MODEL_NAME 是本地目录 → 直接用；models/ 下有同名目录（如 models/bge-m3）→ 用它；否则从 HuggingFace 下载。
# 国内下载慢可设置 HF_ENDPOINT=https://hf-mirror.com
# EMBEDDING__MODEL_NAME=BAAI/bge-m3
# RERANKER__MODEL_NAME=BAAI/bge-reranker-v2-m3
# EMBEDDING__BATCH_SIZE=16
